  "fixed_sql": [
    {
      "name": "alarms",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"alarms\" (\"id\" TEXT NOT NULL, \"local_hour\" INTEGER NOT NULL CHECK(local_hour BETWEEN 0 AND 23), \"local_minute\" INTEGER NOT NULL CHECK(local_minute BETWEEN 0 AND 59), \"label\" TEXT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"enabled\" IN (0, 1)), \"recurrence_type\" TEXT NOT NULL, \"repeat_days_mask\" INTEGER NOT NULL DEFAULT 0, \"sound_id\" TEXT NOT NULL, \"adaptive_sound_rotation\" INTEGER NOT NULL DEFAULT 0 CHECK (\"adaptive_sound_rotation\" IN (0, 1)), \"vibration_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"vibration_enabled\" IN (0, 1)), \"snooze_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"snooze_enabled\" IN (0, 1)), \"snooze_duration_minutes\" INTEGER NOT NULL CHECK(snooze_duration_minutes BETWEEN 1 AND 60), \"definition_revision\" INTEGER NOT NULL DEFAULT 1, \"created_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "alarm_sounds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"alarm_sounds\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"asset_path\" TEXT NOT NULL, \"sound_family\" TEXT NOT NULL, \"intensity_level\" INTEGER NOT NULL CHECK(intensity_level BETWEEN 1 AND 5), \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"last_used_at_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "wake_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wake_sessions\" (\"id\" TEXT NOT NULL, \"alarm_id\" TEXT NOT NULL, \"scheduled_time_ms\" INTEGER NOT NULL, \"triggered_at_ms\" INTEGER NOT NULL, \"initial_sound_id\" TEXT NOT NULL, \"initial_volume\" REAL NULL, \"first_interaction_at_ms\" INTEGER NULL, \"response_latency_ms\" INTEGER NULL, \"snooze_count\" INTEGER NOT NULL DEFAULT 0, \"sound_change_count\" INTEGER NOT NULL DEFAULT 0, \"escalation_count\" INTEGER NOT NULL DEFAULT 0, \"dismissed_at_ms\" INTEGER NULL, \"outcome\" TEXT NOT NULL, \"created_at_ms\" INTEGER NOT NULL, \"completed_at_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "wake_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wake_events\" (\"id\" TEXT NOT NULL, \"wake_session_id\" TEXT NOT NULL, \"sequence_number\" INTEGER NOT NULL, \"event_type\" TEXT NOT NULL, \"occurred_at_ms\" INTEGER NOT NULL, \"metadata_json\" TEXT NOT NULL, \"source\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value_type\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "wake_events_session_sequence",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX wake_events_session_sequence ON wake_events (wake_session_id, sequence_number)"
        }
      ]
    }
